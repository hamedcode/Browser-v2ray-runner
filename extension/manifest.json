{
  "manifest_version": 3,
  "name": "Browser v2ray Runner",
  "version": "1.1.0",
  "description": "Run vless, vmess, trojan, shadowsocks, and socks5 proxy configs entirely inside the browser — no VPN, no system-wide changes. Supports subscription links, parallel real-delay testing, live traffic stats, and exit-IP lookup.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "proxy",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "116",
  "key": ""
}
